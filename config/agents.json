{
  "pi": { "enabled": true, "command": "pi", "args": ["-p", "--no-tools", "{prompt}"], "timeout": 60 },
  "mock": {
    "enabled": true,
    "command": "node",
    "args": ["-e", "console.log(JSON.stringify({template:'key-points',slots:{title:'示例标题',points:['甲','乙','丙']},answer:'这是 mock 回答'}))"],
    "timeout": 10
  },
  "mock-text": {
    "enabled": true,
    "command": "node",
    "args": ["-e", "console.log('这是一段纯文本回答')"],
    "timeout": 10
  }
}
